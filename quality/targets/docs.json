[
  {
    "id": "docs.dead_paths",
    "params": {
      "doc_set_left_out": [
        {
          "glob": ".github/pull_request_template.md",
          "why": "the PR form; PR bodies are scored on the Pull requests tab"
        },
        {
          "glob": "baseline/**",
          "why": "a read-only copy of the v2 brand; never edited (CLAUDE.md)"
        },
        {
          "glob": "concepts/README.md",
          "why": "a placeholder for a folder Wave 2 fills; mapped once it holds files"
        },
        {
          "glob": "dist/README.md",
          "why": "a placeholder for a folder Wave 2 fills; mapped once it holds files"
        },
        {
          "glob": "logo/README.md",
          "why": "a placeholder for a folder Wave 2 fills; mapped once it holds files"
        },
        {
          "glob": "templates/README.md",
          "why": "a placeholder for a folder Wave 2 fills; mapped once it holds files"
        },
        {
          "glob": "tokens/README.md",
          "why": "a placeholder for a folder Wave 2 fills; mapped once it holds files"
        },
        {
          "glob": "decisions.md",
          "why": "an append-only log; each entry is short and dated"
        },
        {
          "glob": "CODE_OF_CONDUCT.md",
          "why": "the Contributor Covenant 2.1, kept verbatim"
        },
        {
          "glob": "research/strategy/candidates.md",
          "why": "a scored record of candidates, kept whole as evidence"
        },
        {
          "glob": "governance/survey.md",
          "why": "the survey instrument, its questions verbatim"
        }
      ],
      "skip_dirs": [
        "worktrees",
        "site",
        "quality"
      ],
      "areas": [
        {
